# API Configuration
VUE_APP_API_URL = https://fakestoreapi.com

# App Configuration
VUE_APP_APP_NAME = ecommerce-app

# Feature Flags
VUE_APP_ENABLE_DEBUG = false
VUE_APP_ENABLE_MOCKS = false

# Storage Keys
VUE_APP_CART_STORAGE_KEY = ecommerce_cart
VUE_APP_WISHLIST_STORAGE_KEY = ecommerce_wishlist
VUE_APP_AUTH_STORAGE_KEY = ecommerce_auth